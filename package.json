{
  "name": "oh-hell-score",
  "version": "3.0.0",
  "private": true,
  "dependencies": {
    "@capacitor/app": "^8.0.0",
    "@capacitor/core": "^8.0.2",
    "@capacitor/haptics": "^8.0.0",
    "@capacitor/keyboard": "^8.0.0",
    "@capacitor/status-bar": "^8.0.0",
    "@ionic/react": "^8.7.17",
    "@ionic/react-router": "^8.7.17",
    "@ionic/storage": "^4.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.19.10",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@types/react-router": "^5.1.20",
    "@types/react-router-dom": "^5.3.3",
    "ajv": "^8.17.1",
    "ionicons": "^7.4.0",
    "react": "^18.3.1",
    "react-combine-reducers": "^1.1.1",
    "react-dom": "^18.3.1",
    "react-router": "^5.3.4",
    "react-router-dom": "^5.3.4",
    "react-scripts": "^5.0.1",
    "typescript": "^5.7.0",
    "web-vitals": "^4.2.4",
    "workbox-background-sync": "^7.4.0",
    "workbox-broadcast-update": "^7.4.0",
    "workbox-cacheable-response": "^7.4.0",
    "workbox-core": "^7.4.0",
    "workbox-expiration": "^7.4.0",
    "workbox-google-analytics": "^7.4.0",
    "workbox-navigation-preload": "^7.4.0",
    "workbox-precaching": "^7.4.0",
    "workbox-range-requests": "^7.4.0",
    "workbox-routing": "^7.4.0",
    "workbox-strategies": "^7.4.0",
    "workbox-streams": "^7.4.0"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "lint": "eslint src",
    "test": "react-scripts test",
    "test:ci": "react-scripts test --watchAll=false --coverage",
    "test:coverage": "react-scripts test --coverage --watchAll=false",
    "test:unit": "react-scripts test --testPathPattern=__tests__ --watchAll=false",
    "test:integration": "react-scripts test --testPathPattern='(pages|components)' --watchAll=false",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "e2e:debug": "playwright test --debug",
    "e2e:ui": "playwright test --ui",
    "eject": "react-scripts eject"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "jest": {
    "transformIgnorePatterns": [
      "node_modules/(?!(@ionic|@stencil|ionicons)/)"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 42,
        "branches": 48,
        "functions": 27,
        "lines": 39
      }
    },
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/**/*.d.ts",
      "!src/index.tsx",
      "!src/reportWebVitals.ts",
      "!src/service-worker.ts",
      "!src/serviceWorkerRegistration.ts",
      "!src/**/*.test.{ts,tsx}",
      "!src/test/**",
      "!src/__tests__/**"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.2",
    "@ionic/eslint-config": "^0.4.0",
    "@playwright/test": "^1.58.2",
    "@types/react-combine-reducers": "^1.0.3",
    "eslint": "^8.57.1",
    "sass": "^1.97.3"
  },
  "description": "Oh Hell Score",
  "overrides": {
    "ajv-keywords": {
      "ajv": "^8.17.1"
    },
    "react-scripts": {
      "typescript": "$typescript"
    }
  }
}
